{
  "name": "acquisition-grade-template",
  "version": "1.0.0",
  "description": "Acquisition-grade tier 1 template with Microsoft governance, kernel invariants, and authority receipt chains",
  "main": "scripts/github-app/index.js",
  "type": "module",
  "license": "MIT",
  "engines": {"node": ">=24.0.0", "npm": ">=10.0.0"},
  "scripts": {
    "test": "npm run test:unit && npm run test:lint",
    "test:unit": "node --test test/template.test.js && npm --prefix cranium-core-hardened test",
    "test:lint": "node --check scripts/github-app/index.js && npm --prefix cranium-core-hardened run build",
    "start": "node scripts/github-app/index.js",
    "audit": "npm audit --audit-level=high && npm --prefix cranium-core-hardened audit --audit-level=high",
    "build": "npm --prefix cranium-core-hardened run build"
  },
  "workspaces": ["scripts/github-app"],
  "keywords": ["acquisition-grade", "microsoft-tier-1", "kernel-invariants", "authority-receipt-chain", "governed-commits", "property-registry"],
  "author": "worthwyl2022-cloud",
  "repository": {"type": "git", "url": "https://github.com/worthwyl2022-cloud/acquisition-grade-template.git"},
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "body-parser": "^2.3.0",
    "express": "^5.2.1"
  },
  "files": ["scripts/", "src/", "cranium-push/", "LICENSE", "README.md", "SECURITY.md", "CODE_OF_CONDUCT.md", "PROPERTY_REGISTRY.md"]
}
